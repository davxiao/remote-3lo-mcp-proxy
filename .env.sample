# Remote MCP & OAuth 3LO Targets
TARGET_MCP_URL="https://<REMOTE_MCP_HOST>/admin/<ENVIRONMENT_ID>/mcp"
TARGET_AUTH_URL="https://<REMOTE_AUTH_HOST>/<ENVIRONMENT_ID>/as/authorize"
TARGET_TOKEN_URL="https://<REMOTE_AUTH_HOST>/<ENVIRONMENT_ID>/as/token"

# GCP Cloud Run Deployment Configuration
PROJECT_ID="<YOUR_GCP_PROJECT_ID>"
REGION="us-central1"
SERVICE_NAME="remote-3lo-mcp-proxy"
MAX_INSTANCES="2"

# Server Settings
HOST="0.0.0.0"
PORT="8080"
CLIENT_TIMEOUT_SECONDS="3600.0"

# Logging & Persistence Configuration
LOG_PAYLOADS="true"
LOG_PAYLOAD_MAX_BYTES="5242880"
REDACT_SECRETS="false"
GCS_LOG_BUCKET="<OPTIONAL_GCS_BUCKET_NAME>"
LOCAL_LOG_DIR="./traffic_logs"
